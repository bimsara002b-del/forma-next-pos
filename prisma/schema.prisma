generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  barcode     String?         @unique
  name        String
  category    String          @default("General")
  priceCents  Int
  costCents   Int             @default(0)
  stockQty    Int             @default(0)
  minStockQty Int             @default(5)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  saleItems   SaleItem[]
  movements   StockMovement[]
  receiptLines InventoryReceiptLine[]

  @@index([name])
  @@index([category])
}

model Sale {
  id                  String     @id @default(cuid())
  requestId           String     @unique
  receiptNumber       String     @unique
  totalCents          Int
  receivedCents       Int
  changeCents         Int
  paymentMethod       String     @default("CASH")
  createdAt           DateTime   @default(now())
  items               SaleItem[]
  shiftId             String?
  shift               CashShift?  @relation(fields: [shiftId], references: [id])

  @@index([createdAt])
  @@index([shiftId])
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  sale           Sale    @relation(fields: [saleId], references: [id])
  product        Product @relation(fields: [productId], references: [id])

  @@index([saleId])
}

model StockMovement {
  id          String    @id @default(cuid())
  productId   String
  changeQty   Int
  reason      String
  reference   String?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}


// Local staff access pilot; not yet a multi-tenant SaaS identity model.
model StaffUser {
  id             String   @id @default(cuid())
  username       String   @unique
  displayName    String
  passwordHash   String
  role           String   @default("CASHIER")
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


// Local pilot: persisted failed sign-in count keyed by HMAC, not plaintext username.
model LoginThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowEndsAt DateTime
  lockedUntil  DateTime?
  updatedAt    DateTime  @updatedAt
}

// Local owner account lifecycle audit (no passwords or secret tokens stored).
model StaffAuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  action    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId, createdAt])
}


// Single physical/demo register (REG-01); no multi-tenant register access yet.
model CashRegister {
  id             String      @id
  displayName    String
  activeShiftId  String?
  shifts         CashShift[]
}

// A shift can be closed only once. Financial values use integer cents.
model CashShift {
  id                String         @id @default(cuid())
  registerId        String
  register          CashRegister   @relation(fields: [registerId], references: [id])
  status            String         @default("OPEN")
  openedById        String
  openedByName      String
  closedById        String?
  openingFloatCents Int
  countedCashCents  Int?
  expectedCashCents Int?
  varianceCents     Int?
  openedAt          DateTime       @default(now())
  closedAt          DateTime?
  sales             Sale[]
  movements         CashMovement[]

  @@index([registerId, openedAt])
  @@index([status])
}

// Signed cash movement; requestId prevents duplicate cash-in/out on retries.
model CashMovement {
  id          String    @id @default(cuid())
  requestId   String    @unique
  shiftId     String
  shift       CashShift @relation(fields: [shiftId], references: [id])
  type        String
  changeCents Int
  recordedById String
  note        String
  createdAt   DateTime  @default(now())

  @@index([shiftId, createdAt])
}


// Additive purchase-receiving ledger for a local single-store demo.
// requestId makes a repeated receive operation idempotent.
model InventoryReceipt {
  id           String                 @id @default(cuid())
  requestId    String                 @unique
  supplierName String
  reference    String
  receivedById String
  createdAt    DateTime               @default(now())
  lines        InventoryReceiptLine[]

  @@index([createdAt])
}

model InventoryReceiptLine {
  id               String           @id @default(cuid())
  receiptId        String
  receipt          InventoryReceipt @relation(fields: [receiptId], references: [id])
  productId        String
  product          Product          @relation(fields: [productId], references: [id])
  productName      String
  quantity         Int
  unitCostCents    Int

  @@index([receiptId])
  @@index([productId])
}
