generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  barcode     String?         @unique
  name        String
  category    String          @default("General")
  priceCents  Int
  costCents   Int             @default(0)
  stockQty    Int             @default(0)
  minStockQty Int             @default(5)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  saleItems   SaleItem[]
  movements   StockMovement[]

  @@index([name])
  @@index([category])
}

model Sale {
  id                  String     @id @default(cuid())
  requestId           String     @unique
  receiptNumber       String     @unique
  totalCents          Int
  receivedCents       Int
  changeCents         Int
  paymentMethod       String     @default("CASH")
  createdAt           DateTime   @default(now())
  items               SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  sale           Sale    @relation(fields: [saleId], references: [id])
  product        Product @relation(fields: [productId], references: [id])

  @@index([saleId])
}

model StockMovement {
  id          String    @id @default(cuid())
  productId   String
  changeQty   Int
  reason      String
  reference   String?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}


// Local staff access pilot; not yet a multi-tenant SaaS identity model.
model StaffUser {
  id             String   @id @default(cuid())
  username       String   @unique
  displayName    String
  passwordHash   String
  role           String   @default("CASHIER")
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


// Local pilot: persisted failed sign-in count keyed by HMAC, not plaintext username.
model LoginThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowEndsAt DateTime
  lockedUntil  DateTime?
  updatedAt    DateTime  @updatedAt
}

// Local owner account lifecycle audit (no passwords or secret tokens stored).
model StaffAuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  action    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId, createdAt])
}
